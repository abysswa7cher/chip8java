<!--                    <id>verify</id>-->
<!--                    <goals>-->
<!--                        <goal>verify</goal>-->
<!--                    </goals>-->
<!--                </execution>-->
<!--            </executions>-->
<!--        </plugin>-->
    </plugins>
</build>
</project>
